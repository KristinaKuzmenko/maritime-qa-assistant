        """Create mock graph client."""
        client = Mock()
        client.get_all_documents = AsyncMock(return_value=[
            {
                "id": "doc_001",
                "title": "Engine Manual",
                "status": "completed",
                "created_at": "2024-01-15",
                "total_pages": 150,
                "owner": "user1"
            },
            {
                "id": "doc_002",
                "title": "Fuel System Guide",
                "status": "completed",
                "created_at": "2024-01-16",
                "total_pages": 80,
                "owner": "user1"
            }
        ])
        return client
    
    @pytest.mark.asyncio
    async def test_list_documents(self, mock_graph_client):
        """Test listing documents."""
        from routes.documents import list_documents
        
        with patch('routes.documents.graph_client', mock_graph_client):
            response = await list_documents(owner=None)
            
            assert len(response) == 2
