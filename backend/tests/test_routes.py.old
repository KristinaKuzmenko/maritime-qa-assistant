class TestDocumentUploadEndpoint:
    """Tests for POST /documents/upload endpoint."""
    
    @pytest.fixture
    def mock_document_processor(self):
        """Create mock document processor."""
        processor = Mock()
        processor.process_document = AsyncMock(return_value="doc_123")
        return processor
    
    @pytest.mark.asyncio
    async def test_upload_success(self, mock_document_processor):
        """Test successful document upload."""
        from routes.documents import upload_document, processing_status
        
        with patch('routes.documents.document_processor', mock_document_processor):
            # Create mock file
            mock_file = Mock()
            mock_file.filename = "test.pdf"
            mock_file.read = AsyncMock(return_value=b"%PDF-1.4 test content")
            
            # Create mock request and background_tasks
            request = Mock()
            request.state = Mock()
            request.state.user_role = "admin"
            request.state.user_id = "test_user"
            background_tasks = Mock()
            background_tasks.add_task = Mock()
            
            with tempfile.TemporaryDirectory() as tmpdir:
                with patch('routes.documents.Path') as mock_path:
                    mock_path.return_value.mkdir = Mock()
                    mock_path.return_value.__truediv__ = lambda self, x: f"{tmpdir}/{x}"
                    
                    # Mock open for file writing
                    with patch('builtins.open', create=True):
                        response = await upload_document(
                            request=request,
                            background_tasks=background_tasks,
                            file=mock_file,
                            title="Test Manual",
                            doc_type="manual",
                            owner="test_user",
                            tags="fuel,pump",
                        )
            
            assert "task_id" in response
            assert "doc_id" in response
            assert response["message"] == "Document upload started"
            background_tasks.add_task.assert_called_once()
    
    @pytest.mark.asyncio
    async def test_upload_invalid_file_type(self):
        """Test upload rejects non-PDF files."""
        from routes.documents import upload_document
        
        with patch('routes.documents.document_processor', Mock()):
            mock_file = Mock()
            mock_file.filename = "test.docx"
            
            request = Mock()
            request.state = Mock()
            request.state.user_role = "admin"
            request.state.user_id = "test_user"
            background_tasks = Mock()
            
            with pytest.raises(HTTPException) as exc_info:
                await upload_document(
                    request=request,
                    background_tasks=background_tasks,
                    file=mock_file,
                    title="Test",
                )
            
            assert exc_info.value.status_code == 400
            assert "PDF" in exc_info.value.detail
    
    @pytest.mark.asyncio
    async def test_upload_service_unavailable(self):
        """Test upload when processor not available."""
        from routes.documents import upload_document
        
        with patch('routes.documents.document_processor', None):
            mock_file = Mock()
            mock_file.filename = "test.pdf"
            
            request = Mock()
            request.state = Mock()
            request.state.user_role = "admin"
            request.state.user_id = "test_user"
            background_tasks = Mock()
            
            with pytest.raises(HTTPException) as exc_info:
                await upload_document(
                    request=request,
                    background_tasks=background_tasks,
                    file=mock_file,
                    title="Test",
                )
            
            assert exc_info.value.status_code == 503


class TestDocumentUploadStatusEndpoint:
    """Tests for GET /documents/upload/status/{task_id} endpoint."""
    
    @pytest.mark.asyncio
    async def test_status_queued(self):
        """Test status for queued task."""
        from routes.documents import get_upload_status, processing_status
        
        processing_status["task_123"] = {
            "status": "queued",
            "progress": 0,
            "doc_id": "doc_123",
            "message": "Queued for processing"
        }
        
        response = await get_upload_status("task_123")
        
        assert response["status"] == "queued"
        assert response["progress"] == 0
    
    @pytest.mark.asyncio
    async def test_status_processing(self):
        """Test status for processing task."""
        from routes.documents import get_upload_status, processing_status
        
        processing_status["task_456"] = {
            "status": "processing",
            "progress": 50,
            "doc_id": "doc_456",
            "message": "Processing... 50%"
        }
        
        response = await get_upload_status("task_456")
        
        assert response["status"] == "processing"
        assert response["progress"] == 50
    
    @pytest.mark.asyncio
    async def test_status_completed(self):
        """Test status for completed task."""
        from routes.documents import get_upload_status, processing_status
        
        processing_status["task_789"] = {
            "status": "completed",
            "progress": 100,
            "doc_id": "doc_789",
            "message": "Processing completed"
        }
        
        response = await get_upload_status("task_789")
        
        assert response["status"] == "completed"
        assert response["progress"] == 100
    
    @pytest.mark.asyncio
    async def test_status_not_found(self):
        """Test status for unknown task."""
        from routes.documents import get_upload_status
        
        with pytest.raises(HTTPException) as exc_info:
            await get_upload_status("unknown_task")
        
        assert exc_info.value.status_code == 404


class TestDocumentListEndpoint:
    """Tests for GET /documents endpoint."""
    
    @pytest.fixture
