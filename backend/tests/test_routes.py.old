class TestExtractToolsUsed:
    """Tests for _extract_tools_used helper."""
    
    def test_extract_from_tool_calls_attr(self):
        """Test extraction from tool_calls attribute."""
        from routes.chat import _extract_tools_used
        
        msg = Mock()
        msg.tool_calls = [{"name": "qdrant_search_text"}, {"name": "neo4j_query"}]
        
        result = _extract_tools_used([msg])
        
        assert "qdrant_search_text" in result
        assert "neo4j_query" in result
    
    def test_extract_from_additional_kwargs(self):
        """Test extraction from additional_kwargs."""
        from routes.chat import _extract_tools_used
        
        msg = Mock(spec=[])  # No tool_calls attr
        msg.additional_kwargs = {"tool_calls": [{"name": "qdrant_search_tables"}]}
        
        result = _extract_tools_used([msg])
        
        assert "qdrant_search_tables" in result
    
    def test_extract_no_tools(self):
        """Test extraction when no tools used."""
        from routes.chat import _extract_tools_used
        
        msg = Mock(spec=[])
        msg.additional_kwargs = {}
        
        result = _extract_tools_used([msg])
        
        assert result == []
    
    def test_extract_deduplicates(self):
        """Test duplicate tools are deduplicated."""
        from routes.chat import _extract_tools_used
        
        msg1 = Mock()
        msg1.tool_calls = [{"name": "qdrant_search_text"}]
        msg2 = Mock()
        msg2.tool_calls = [{"name": "qdrant_search_text"}]
        
        result = _extract_tools_used([msg1, msg2])
        
        assert result.count("qdrant_search_text") == 1


