class TestDocumentDownloadEndpoint:
    """Tests for GET /documents/{doc_id}/download endpoint."""
    
    @pytest.mark.asyncio
    async def test_download_success(self):
        """Test successful file download."""
        from routes.documents import download_document
        
        # Create temp file
        with tempfile.NamedTemporaryFile(suffix=".pdf", delete=False) as f:
            f.write(b"%PDF-1.4 test content")
            temp_path = f.name
        
        try:
            with patch('routes.documents.Path') as mock_path:
                mock_path_instance = Mock()
                mock_path_instance.exists.return_value = True
                mock_path.return_value = mock_path_instance
                
                # The actual function returns FileResponse
                # We can't easily test FileResponse, but we can test the path logic
                pass
        finally:
            os.unlink(temp_path)
    
    @pytest.mark.asyncio
    async def test_download_not_found(self):
        """Test download when file doesn't exist."""
        from routes.documents import download_document
        
        with patch('routes.documents.Path') as mock_path:
            mock_path_instance = Mock()
            mock_path_instance.exists.return_value = False
            mock_path.return_value = mock_path_instance
            
            with pytest.raises(HTTPException) as exc_info:
                await download_document("nonexistent_doc")
            
            assert exc_info.value.status_code == 404


class TestBackgroundProcessing:
    """Tests for background document processing."""
    
    @pytest.mark.asyncio
    async def test_process_document_background_success(self):
        """Test successful background processing."""
        from routes.documents import process_document_background, processing_status, DocumentMetadata
        
        mock_processor = Mock()
        mock_processor.process_document = AsyncMock(return_value="doc_001")
        
        metadata = DocumentMetadata(
            title="Test Manual",
            doc_type="manual",
            owner="user1",
            tags=["test"]
        )
        
        with patch('routes.documents.document_processor', mock_processor):
            await process_document_background(
                task_id="task_001",
                doc_id="doc_001",
                file_path="/path/to/file.pdf",
                metadata=metadata
            )
        
        assert processing_status["task_001"]["status"] == "completed"
        assert processing_status["task_001"]["progress"] == 100
    
    @pytest.mark.asyncio
    async def test_process_document_background_failure(self):
        """Test background processing failure."""
        from routes.documents import process_document_background, processing_status, DocumentMetadata
        
        mock_processor = Mock()
        mock_processor.process_document = AsyncMock(
            side_effect=Exception("Processing failed")
        )
        
        metadata = DocumentMetadata(title="Test")
        
        with patch('routes.documents.document_processor', mock_processor):
            await process_document_background(
                task_id="task_002",
                doc_id="doc_002",
                file_path="/path/to/file.pdf",
                metadata=metadata
            )
        
        assert processing_status["task_002"]["status"] == "failed"
        assert "Processing failed" in processing_status["task_002"]["error"]
    
    @pytest.mark.asyncio
    async def test_process_document_background_no_processor(self):
        """Test background processing without processor."""
        from routes.documents import process_document_background, processing_status, DocumentMetadata
        
        metadata = DocumentMetadata(title="Test")
        
        with patch('routes.documents.document_processor', None):
            await process_document_background(
                task_id="task_003",
                doc_id="doc_003",
                file_path="/path/to/file.pdf",
                metadata=metadata
            )
        
        assert processing_status["task_003"]["status"] == "failed"
        assert "not initialized" in processing_status["task_003"]["error"]


# =============================================================================
# PYDANTIC MODEL TESTS
# =============================================================================

class TestPydanticModels:
    """Tests for Pydantic request/response models."""
    
    def test_question_request_defaults(self):
        """Test QuestionRequest default values."""
        from routes.chat import QuestionRequest
        
        req = QuestionRequest(question="Test question")
        
        assert req.question == "Test question"
        assert req.user_id == "global"
        assert req.chat_history == []
        assert req.owner is None
        assert req.doc_ids is None
    
    def test_question_request_full(self):
        """Test QuestionRequest with all fields."""
        from routes.chat import QuestionRequest
        
        req = QuestionRequest(
            question="Test",
            user_id="user123",
            chat_history=[{"role": "user", "content": "hi"}],
            owner="owner1",
            doc_ids=["doc1", "doc2"]
        )
        
        assert req.user_id == "user123"
        assert len(req.chat_history) == 1
        assert req.owner == "owner1"
        assert len(req.doc_ids) == 2
    
    def test_document_metadata_defaults(self):
        """Test DocumentMetadata default values."""
        from routes.documents import DocumentMetadata
        
        meta = DocumentMetadata(title="Test Doc")
        
        assert meta.title == "Test Doc"
        assert meta.doc_type == "manual"
        assert meta.owner == "global"
        assert meta.tags == []
    
    def test_document_response(self):
        """Test DocumentResponse model."""
        from routes.documents import DocumentResponse
        
        resp = DocumentResponse(
            doc_id="doc_001",
            title="Engine Manual",
            status="completed",
            created_at="2024-01-15",
            total_pages=150,
            owner="user1"
        )
        
        assert resp.doc_id == "doc_001"
        assert resp.total_pages == 150


if __name__ == "__main__":
    pytest.main([__file__, "-v"])