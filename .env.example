# Maritime Q&A Assistant - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# REQUIRED SETTINGS - Must be set for the application to work

# LLM Provider: "openai" or "groq" or "cerebras"
LLM_PROVIDER=groq

# OpenAI API Key (required for embeddings, and for LLM if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (required if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# Cerebras API Key (required if LLM_PROVIDER=cerebras)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Neo4j Graph Database Password
NEO4J_PASSWORD=your_neo4j_password_here


# OPTIONAL SETTINGS - Have defaults, but can be customized

# API Configuration
API_TITLE=Maritime Documentation Q&A Assistant
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687 # or neo4j+s://your_neo4j_instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# LLM Models
# For Groq: openai/gpt-oss-120b, llama-3.3-70b-versatile
# For OpenAI: gpt-5-mini, gpt-4o-mini
LLM_MODEL=openai/gpt-oss-120b
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=  # Optional for cloud Qdrant
QDRANT_USE_HTTPS=false

# Qdrant Collections
TEXT_CHUNKS_COLLECTION=text_chunks
SCHEMAS_COLLECTION=schemas
TABLES_TEXT_COLLECTION=tables

# Vector Configuration
VECTOR_DIMENSION=1536
VECTOR_INDEX_TYPE=cosine

# Storage Configuration
# Primary storage: S3 (production) or local (development)
STORAGE_TYPE=s3
S3_PREFIX=data
S3_BUCKET_NAME=maritime-qa-docs
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# For local development without S3:
# STORAGE_TYPE=local
# LOCAL_STORAGE_PATH=../../data

# Processing Configuration
CHUNK_SIZE=50
MAX_FILE_SIZE=104857600  # 100MB in bytes
SUPPORTED_LANGUAGES=["en", "ru"]

# Performance Configuration
MAX_WORKERS=4
BATCH_SIZE=10
QUERY_TIMEOUT=30
 

# Authentication Configuration (optional)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_here
AUTH_SECRET_KEY=your_secret_key_here